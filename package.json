{
  "name": "sajiklik",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @sajiklik/api\" \"npm run dev -w @sajiklik/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run test -w @sajiklik/api",
    "db:generate": "npm run db:generate -w @sajiklik/api",
    "db:migrate": "npm run db:migrate -w @sajiklik/api",
    "db:seed": "npm run db:seed -w @sajiklik/api"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.2",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
